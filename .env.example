# Django Configuration
SECRET_KEY=change-me-in-production-use-a-strong-secret-key-at-least-50-chars
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DATABASE_URL=sqlite:///db.sqlite3

# Email (defaults to console backend if empty or dev)
# EMAIL_URL=smtp://user:password@smtp.example.com:587/?tls=True
DEFAULT_FROM_EMAIL=BountyBoard <notifications@bountyboard.campus>

# Optional email domain restriction (leave empty to allow all domains)
# Example: edu.in or iitb.ac.in
ALLOWED_EMAIL_DOMAIN=

# Security & Hosting (Production)
CSRF_TRUSTED_ORIGINS=https://localhost,http://127.0.0.1
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Campus verification (required in production; dev.py supplies throwaway values)
# REG_NO_HMAC_KEY: >= 32 random chars, distinct from SECRET_KEY. Keep it out of backups and the repo.
# REG_NO_HMAC_KEY=
# CARD_NAME_KEYS: comma-separated Fernet keys, first one encrypts. Generate with:
#   python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# CARD_NAME_KEYS=
# VERIFICATION_TTL_DAYS=365
